# LLM (OpenAI兼容接口)
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
# 生成最大 token 数（deepseek-v4-flash 的 reasoning_content 会吃预算，默认 1024 避免空 content）
# LLM_MAX_TOKENS=1024

# Embedding (本地 HuggingFace 模型，免费)
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# 向量数据库
VECTOR_DB_PATH=./data/vector_db

# 对话数据库
DB_PATH=./data/history_chat.db

# 记忆（可选）
# MAX_HISTORY=10

# 检索（可选）
# 防跨人物污染阈值（由 scripts/evaluate_retrieval_full.py 在 198 集 train 子集标定，默认 1.25）
# FILTERED_SCORE_RATIO=1.25
# 检索返回给 LLM 的史料条数（默认 3）
# RAG_TOP_K=3
# 多人物联合检索返回条数（默认 7，评测 multi 子集按此口径算 Recall）
# MULTI_TOP_K=7
# 检索模式：similarity（纯相似度，默认）| mmr（最大边际相关重排）| hybrid（稠密向量 + BM25 RRF 融合召回，精确人名/罕见词/多人物枚举更稳）
# RETRIEVAL_MODE=similarity

# 检索重排（可选）
# rerank_mode：hybrid（默认，jieba+TF-IDF 词法与稠密 RRF 融合，离线）| cross_encoder（bge-reranker，需本地 HF 缓存）| none（关闭，保持纯相似度）
# RERANK_MODE=hybrid
# 重排/去重前的候选池大小：先召回 k_fetch 条再精排（或按人物去重）取 top-k
# RERANK_K_FETCH=15

# 数据源双轨（可选）
# persona_fallback=True（默认）：persona（内置摘要·非权威）可参与检索但史源优先；False=严格模式，仅真实史源可检索/引用
# PERSONA_FALLBACK=true

# 对话清理（可选，默认 0=不清理；设置后由 scripts/cleanup_db.py 执行）
# CONVERSATION_RETENTION_DAYS=90
