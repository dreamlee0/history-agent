# LLM (OpenAI兼容接口)
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
# 生成最大 token 数（deepseek-v4-flash 的 reasoning_content 会吃预算，默认 1024 避免空 content）
# LLM_MAX_TOKENS=1024

# Embedding (本地 HuggingFace 模型，免费)
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# 向量数据库
VECTOR_DB_PATH=./data/vector_db

# 对话数据库
DB_PATH=./data/history_chat.db

# 记忆（可选）
# MAX_HISTORY=10

# 检索（可选）
# 防跨人物污染阈值（由 scripts/evaluate_retrieval_full.py 在 198 集 train 子集标定，默认 1.25）
# FILTERED_SCORE_RATIO=1.25
# 检索返回给 LLM 的史料条数（默认 3）
# RAG_TOP_K=3
# 多人物联合检索返回条数（默认 7，评测 multi 子集按此口径算 Recall）
# MULTI_TOP_K=7
# 检索模式：similarity（默认）| mmr（最大边际相关重排，史料量大时启用）
# RETRIEVAL_MODE=similarity

# 对话清理（可选，默认 0=不清理；设置后由 scripts/cleanup_db.py 执行）
# CONVERSATION_RETENTION_DAYS=90
