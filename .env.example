# LLM (OpenAI兼容接口)
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4.5-flash

# Embedding (本地 HuggingFace 模型，免费)
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# 向量数据库
VECTOR_DB_PATH=./data/vector_db

# 对话数据库
DB_PATH=./data/history_chat.db

# 记忆（可选）
# MAX_HISTORY=10

# 检索（可选）
# 防跨人物污染阈值（由 scripts/evaluate_retrieval.py 在标注评测集上标定，默认 1.20）
# FILTERED_SCORE_RATIO=1.20
# 检索模式：similarity（默认）| mmr（最大边际相关重排，史料量大时启用）
# RETRIEVAL_MODE=similarity

# 对话清理（可选，默认 0=不清理；设置后由 scripts/cleanup_db.py 执行）
# CONVERSATION_RETENTION_DAYS=90
